// Cloudflare Worker 설정. 이름은 Cloudflare 에 만든 Worker 이름과 같아야 한다.
{
  "name": "claudecode-mobile-g",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // 공개 파일(/shared/…)도 먼저 문지기를 거친다 — 그래야 잠근 쪽이 새지 않는다
    "run_worker_first": true
  },
  // 계정 저장소 (api.js) — Metaversal Studio 의 아이디 · 캐릭터
  "kv_namespaces": [
    { "binding": "ACCOUNTS", "id": "2ac9f05fd3fa4b30911f1a43a714fb33" }
  ],
  // 접속자 (presence.js) — 세상에 하나뿐인 객체가 기억에만 들고 있다. 무료 판은 SQLite 형만 된다
  "durable_objects": {
    "bindings": [ { "name": "PRESENCE", "class_name": "Presence" } ]
  },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Presence"] } ]
}
